{
  "entities": {
    "AttendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Stores attendance taken by an instructor for a specific course, week, and session.",
      "type": "object",
      "properties": {
        "courseId": {
          "type": "string",
          "description": "Unique identifier for the course",
          "maxLength": 100
        },
        "instructorId": {
          "type": "string",
          "description": "Unique identifier for the instructor",
          "maxLength": 100
        },
        "weekNumber": {
          "type": "number",
          "description": "Week number of the academic term"
        },
        "sessionType": {
          "type": "string",
          "enum": ["1. ders", "2. ders", "ek dersler", "ders yapmadım"],
          "description": "Which lesson session of the week",
          "maxLength": 50
        },
        "absentStudentIds": {
          "type": "array",
          "description": "List of canonical student IDs who were absent (difference set)",
          "maxLength": 100
        },
        "didNotHoldClass": {
          "type": "boolean",
          "description": "True if the instructor selected ders yapmadım"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp or ISO timestamp of last update",
          "maxLength": 64
        },
        "version": {
          "type": "number",
          "description": "Optimistic concurrency version number"
        },
        "updatedBySessionId": {
          "type": "string",
          "description": "Client session identifier for concurrent edit detection",
          "maxLength": 100
        },
        "deletedAt": {
          "type": "string",
          "description": "Soft-delete timestamp",
          "maxLength": 64
        }
      },
      "required": ["courseId", "instructorId", "weekNumber", "sessionType", "absentStudentIds", "didNotHoldClass", "updatedAt"]
    },
    "FeedbackItem": {
      "title": "FeedbackItem",
      "description": "Anonymous feedback submitted from the bottom-left feedback button.",
      "type": "object",
      "properties": {
        "message": {
          "type": "string",
          "description": "Anonymous feedback text",
          "minLength": 1,
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp or ISO timestamp of creation",
          "maxLength": 64
        },
        "deletedAt": {
          "type": "string",
          "description": "Soft-delete timestamp",
          "maxLength": 64
        }
      },
      "required": ["message", "createdAt"]
    },
    "CustomStudent": {
      "title": "CustomStudent",
      "description": "Student dynamically added from the Sibelius admin panel.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "grade": {
          "type": "string",
          "maxLength": 40
        },
        "modality": {
          "type": "string",
          "enum": ["online", "yuzyuze"]
        },
        "enrolledCourseIds": {
          "type": "array",
          "maxLength": 30
        },
        "addedAtWeek": {
          "type": "number"
        },
        "addedAt": {
          "type": "string",
          "maxLength": 64
        },
        "deletedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "name", "grade", "modality", "enrolledCourseIds", "addedAtWeek", "addedAt"]
    },
    "RemovedStudent": {
      "title": "RemovedStudent",
      "description": "Record of a student removed via the Sibelius admin panel.",
      "type": "object",
      "properties": {
        "studentId": {
          "type": "string",
          "maxLength": 120
        },
        "name": {
          "type": "string",
          "maxLength": 120
        },
        "removedAt": {
          "type": "string",
          "maxLength": 64
        },
        "deletedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["studentId", "name", "removedAt"]
    },
    "InstructorAssignment": {
      "title": "InstructorAssignment",
      "description": "Dynamic assignment of an instructor to a course from the Sibelius panel.",
      "type": "object",
      "properties": {
        "courseId": {
          "type": "string",
          "maxLength": 100
        },
        "instructorName": {
          "type": "string",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["courseId", "instructorName", "updatedAt"]
    },
    "UnlistedStudentReport": {
      "title": "UnlistedStudentReport",
      "description": "Student reported by an instructor as present in class but not on the course roster.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128
        },
        "studentName": {
          "type": "string",
          "maxLength": 120
        },
        "courseId": {
          "type": "string",
          "maxLength": 100
        },
        "instructorId": {
          "type": "string",
          "maxLength": 100
        },
        "instructorName": {
          "type": "string",
          "maxLength": 120
        },
        "weekNumber": {
          "type": "number"
        },
        "sessionType": {
          "type": "string",
          "enum": ["1. ders", "2. ders", "ek dersler", "ders yapmadım"],
          "maxLength": 50
        },
        "status": {
          "type": "string",
          "enum": ["pending", "enrolled", "temporary"],
          "maxLength": 30
        },
        "resolvedStudentId": {
          "type": "string",
          "maxLength": 120
        },
        "resolvedExistingStudent": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        },
        "resolvedAt": {
          "type": "string",
          "maxLength": 64
        },
        "deletedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["id", "studentName", "courseId", "instructorId", "instructorName", "weekNumber", "sessionType", "status", "createdAt"]
    },
    "PlaceboSavePreference": {
      "title": "PlaceboSavePreference",
      "description": "Stores whether an instructor has activated the optional placebo save button.",
      "type": "object",
      "properties": {
        "instructorId": {
          "type": "string",
          "maxLength": 120
        },
        "instructorName": {
          "type": "string",
          "maxLength": 120
        },
        "enabled": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["instructorId", "instructorName", "enabled", "updatedAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Audit log of attendance and administrative mutations.",
      "type": "object",
      "properties": {
        "actor": {
          "type": "string",
          "maxLength": 120
        },
        "action": {
          "type": "string",
          "maxLength": 100
        },
        "target": {
          "type": "string",
          "maxLength": 200
        },
        "details": {
          "type": "string",
          "maxLength": 2000
        },
        "createdAt": {
          "type": "string",
          "maxLength": 64
        }
      },
      "required": ["actor", "action", "target", "details", "createdAt"]
    },
    "NotDuplicatePair": {
      "title": "NotDuplicatePair",
      "description": "Ordered pair of two student IDs permanently marked as distinct people (not duplicates).",
      "type": "object",
      "properties": {
        "studentIdA": {
          "type": "string",
          "description": "Lexicographically smaller student ID",
          "maxLength": 120
        },
        "studentIdB": {
          "type": "string",
          "description": "Lexicographically larger student ID",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "description": "Server timestamp or ISO timestamp of creation",
          "maxLength": 64
        },
        "note": {
          "type": "string",
          "description": "Optional note explaining why these two students are distinct",
          "maxLength": 500
        }
      },
      "required": ["studentIdA", "studentIdB", "createdAt"]
    },
    "CoordinatorAssignment": {
      "title": "CoordinatorAssignment",
      "description": "Weekly weekend coordinator duty assignments for Saturday and Sunday.",
      "type": "object",
      "properties": {
        "weekNumber": {
          "type": "number",
          "description": "Academic week number"
        },
        "saturday": {
          "type": "array",
          "description": "Up to 2 coordinator names or nulls assigned for Saturday"
        },
        "sunday": {
          "type": "array",
          "description": "Up to 2 coordinator names or nulls assigned for Sunday"
        },
        "updatedAt": {
          "type": "string",
          "description": "Server timestamp or ISO timestamp of last update"
        }
      },
      "required": ["weekNumber", "updatedAt"]
    }
  },
  "firestore": {
    "/attendance/{recordId}": {
      "schema": "AttendanceRecord",
      "description": "Collection of attendance records per course, week, and session."
    },
    "/feedback/{feedbackId}": {
      "schema": "FeedbackItem",
      "description": "Collection of anonymous feedback messages."
    },
    "/custom_students/{studentId}": {
      "schema": "CustomStudent",
      "description": "Collection of students added after initial setup."
    },
    "/removed_students/{studentId}": {
      "schema": "RemovedStudent",
      "description": "Collection of student IDs removed from the active roster."
    },
    "/instructor_assignments/{courseId}": {
      "schema": "InstructorAssignment",
      "description": "Collection of course instructor assignments."
    },
    "/unlisted_students/{reportId}": {
      "schema": "UnlistedStudentReport",
      "description": "Collection of unlisted students reported by instructors during attendance."
    },
    "/placebo_save_preferences/{instructorId}": {
      "schema": "PlaceboSavePreference",
      "description": "Collection of per-instructor placebo save button toggle preferences."
    },
    "/audit_log/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trail of mutations (who, when, what)."
    },
    "/not_duplicates/{pairId}": {
      "schema": "NotDuplicatePair",
      "description": "Collection of ordered student ID pairs marked as distinct people (not duplicates)."
    },
    "/coordinator_assignments/{assignmentId}": {
      "schema": "CoordinatorAssignment",
      "description": "Collection of weekly coordinator assignments (w01, w02, ...)."
    }
  }
}
